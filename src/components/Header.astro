---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const normalize = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const current = normalize(Astro.url.pathname);

// Icônes affichées uniquement dans la barre de navigation mobile.
const icons: Record<string, string> = {
  '/': 'M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z',
  '/expertise/': 'M12 3 20 7.5v9L12 21l-8-4.5v-9zM12 9.5 15 11.2v3.6L12 16.5l-3-1.7v-3.6z',
  '/experiences/': 'M9 6V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V6M4 7h16a1 1 0 0 1 1 1v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a1 1 0 0 1 1-1zM3 12.5h18',
  '/contact/': 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm-.5 1 8.5 6.5L20.5 7',
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" translate="no">
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <polygon class="outer" points="16,2 28.1,9 28.1,23 16,30 3.9,23 3.9,9"></polygon>
        <polygon class="inner" points="16,10 21.2,13 21.2,19 16,22 10.8,19 10.8,13"></polygon>
      </svg>
      <span>{site.brand}<span class="visually-hidden">, accueil</span></span>
    </a>
    <nav class="page-nav" aria-label="Navigation principale" data-page-nav>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={normalize(item.href) === current ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={icons[item.href]} />
                </svg>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--filet); }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    margin-right: auto;
    font-weight: 650;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
    color: var(--encre);
    text-decoration: none;
  }
  .brand:hover { color: var(--encre); }
  .brand-mark { width: 1.75rem; height: 1.75rem; }
  .brand-mark .outer { fill: none; stroke: var(--cobalt); stroke-width: 2.5; stroke-linejoin: round; }
  .brand-mark .inner { fill: var(--cobalt); }

  .page-nav ul {
    display: flex;
    gap: 0 var(--space-1);
    padding: 0;
    list-style: none;
  }
  .page-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.7rem;
    color: var(--ardoise);
    font-weight: 500;
    text-decoration: none;
    touch-action: manipulation;
  }
  .page-nav a:hover { color: var(--encre); }
  .nav-icon { display: none; }

  /* Ordinateur : en-tête fixe en verre dépoli ; page active = couleur + soulignement épais. */
  @media (min-width: 40.0625rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 40;
      view-transition-name: site-header;
      background: light-dark(rgb(251 252 253 / 0.82), rgb(15 26 42 / 0.82));
      -webkit-backdrop-filter: blur(16px) saturate(160%);
      backdrop-filter: blur(16px) saturate(160%);
    }
    .page-nav a[aria-current='page'] {
      color: var(--encre);
      text-decoration: underline;
      text-decoration-color: var(--cobalt);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45em;
    }
  }

  /* Mobile : barre d'onglets flottante en bas de l'écran, effet verre dépoli. */
  @media (max-width: 40rem) {
    .header-inner { padding-block: var(--space-3); }

    .page-nav {
      position: fixed;
      z-index: 50;
      left: 50%;
      bottom: calc(env(safe-area-inset-bottom) + 0.75rem);
      transform: translateX(-50%);
      width: min(calc(100% - 1.5rem), 25rem);
      padding: 0.3rem;
      border-radius: 999px;
      view-transition-name: tab-bar;

      /* Opacité choisie pour garder un contraste AA des libellés, quel que soit le contenu dessous. */
      background: light-dark(rgb(255 255 255 / 0.8), rgb(26 41 64 / 0.84));
      -webkit-backdrop-filter: blur(22px) saturate(180%);
      backdrop-filter: blur(22px) saturate(180%);
      border: 1px solid light-dark(rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.12));
      box-shadow:
        inset 0 1px 0 light-dark(rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.1)),
        0 1px 2px rgb(15 26 42 / 0.08),
        0 10px 30px -6px light-dark(rgb(15 26 42 / 0.22), rgb(0 0 0 / 0.5));
    }
    .page-nav ul { justify-content: space-between; gap: 0; }
    .page-nav li { flex: 1; }
    .page-nav a {
      flex-direction: column;
      justify-content: center;
      gap: 0.15rem;
      width: 100%;
      min-height: 3.25rem;
      padding: 0.35rem 0.25rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 550;
      color: light-dark(#4b5b70, #c3cedb);
      letter-spacing: 0.005em;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    /* Libellés : restent dans leur onglet même avec un texte agrandi. */
    .page-nav a span {
      max-width: 100%;
      text-align: center;
      line-height: 1.15;
      overflow-wrap: anywhere;
      hyphens: auto;
    }
    .nav-icon {
      display: block;
      flex: none;
      width: 1.4rem;
      height: 1.4rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .page-nav a[aria-current='page'] {
      color: var(--cobalt-fonce);
      background: light-dark(rgb(27 95 168 / 0.1), rgb(142 190 245 / 0.16));
      box-shadow: inset 0 1px 0 light-dark(rgb(255 255 255 / 0.7), rgb(255 255 255 / 0.08));
    }
    .page-nav a:active { background: light-dark(rgb(20 35 58 / 0.06), rgb(255 255 255 / 0.08)); }
  }

  /* Sans flou d'arrière-plan : fond opaque pour garder la lisibilité. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    @media (max-width: 40rem) {
      .page-nav { background: var(--surface); }
    }
  }
</style>
