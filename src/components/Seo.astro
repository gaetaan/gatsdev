---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = site.defaultDescription, image = '/og-image.png', noindex = false } = Astro.props;

const fullTitle = title ? `${title} · ${site.brand}` : `${site.owner}, lead tech Java / Angular freelance à ${site.location}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const imageUrl = new URL(image, Astro.site ?? site.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:site_name" content={site.brand} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.brand} — ${site.owner}, ${site.role}`} />
<meta name="twitter:card" content="summary_large_image" />
