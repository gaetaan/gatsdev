---
// Fin de page commune : même invitation à prendre contact partout.
import { site } from '../data/site';

interface Props {
  secondary?: { href: string; label: string };
}
const { secondary } = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Mission freelance')}`;
---

<aside class="page-end" aria-labelledby="page-end-title">
  <h2 id="page-end-title">Un projet à faire évoluer&#8239;?</h2>
  <p class="lede">
    Disponible le {site.availability}, sur Aix‑Marseille ou à distance. Quelques lignes sur votre contexte suffisent pour
    commencer.
  </p>
  <div class="actions">
    <a class="button" href={mailto}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm-.5 1 8.5 6.5L20.5 7" />
      </svg>
      Écrire un email
    </a>
    {secondary && <a class="button button--ghost" href={secondary.href}>{secondary.label}</a>}
  </div>
</aside>

<style>
  .page-end {
    margin-top: var(--space-24);
    padding: var(--space-8);
    background: var(--surface);
    border-radius: var(--radius);
    border-top: 2px solid var(--encre);
  }
  .page-end h2 { font-size: var(--t-h2); }
  .page-end .lede { margin-top: var(--space-3); max-width: var(--measure); }
  .page-end .actions { margin-top: var(--space-6); }

  @media (max-width: 40rem) {
    .page-end { padding: var(--space-6) var(--space-4); margin-inline: calc(var(--space-2) * -1); }
  }
</style>
