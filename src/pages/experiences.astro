---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experiences';
import { site } from '../data/site';
---

<BaseLayout
  title="Expériences"
  description="Sélection de missions de Gaëtan Barbaria, lead tech full stack freelance : contexte, réalisations et technologies."
>
  <header class="page-header">
    <span class="eyebrow">Expériences</span>
    <h1>Quelques missions</h1>
    <p>Une sélection de missions représentatives. Le détail complet figure dans mon dossier de compétences.</p>
  </header>

  <ol class="timeline">
    {
      experiences.map((xp) => (
        <li>
          <article class="card xp">
            <header>
              <p class="xp-period">{xp.period}</p>
              <h2>{xp.role}</h2>
              <p class="xp-client">{xp.client}</p>
            </header>
            <p>{xp.summary}</p>
            {xp.highlights.length > 0 && (
              <ul>
                {xp.highlights.map((h) => <li>{h}</li>)}
              </ul>
            )}
            <ul class="tags" aria-label="Technologies et méthodes">
              {xp.stack.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="actions">
    <a class="button" href={site.resumePdf} download>Télécharger le dossier de compétences (PDF)</a>
    <a class="button button--ghost" href="/contact/">Me contacter</a>
  </div>
</BaseLayout>

<style>
  .timeline {
    display: grid;
    gap: var(--space-6);
    padding: 0;
    list-style: none;
    max-width: 50rem;
  }
  .xp h2 { font-size: 1.3rem; }
  .xp header { margin-bottom: var(--space-3); }
  .xp-period {
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .xp-client { margin-top: var(--space-1); font-weight: 550; }
  .xp .tags { margin-top: var(--space-4); }
  .xp > ul:not(.tags) { margin-top: var(--space-3); padding-left: 1.1rem; color: var(--text-muted); }
</style>
