---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experiences } from '../data/experiences';
import { site } from '../data/site';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PageEnd from '../components/PageEnd.astro';
---

<BaseLayout
  title="Expériences et missions"
  description="Missions de Gaëtan Barbaria depuis 2020 : refontes vers des microservices DDD / hexagonaux, chat national, migration WebLogic vers Quarkus, encadrement d’équipes."
>
  <PageHeader title="Expériences">
      Six missions depuis 2020, toutes sur des applications métier nationales, de développeur unique à leader technique
      d’une équipe de 8&nbsp;personnes.
      {
        site.showDocuments ? (
          <>
            Le détail complet figure dans le <a href={site.resumePdf} download>dossier de compétences (PDF)</a>.
          </>
        ) : (
          <>
            Mon dossier de compétences détaillé est disponible <a href="/contact/">sur demande</a>.
          </>
        )
      }
  </PageHeader>

  <Section id="missions" title="Missions depuis 2020">
  <ol class="rows timeline">
    {
      experiences.map((xp) => (
        <li class="row" id={xp.id}>
          <p class="row-label">
            <time datetime={xp.start}>{xp.period}</time>
          </p>
          <article class="row-body" aria-labelledby={`${xp.id}-title`}>
            <h3 id={`${xp.id}-title`}>Projet {xp.project}</h3>
            <p class="xp-meta">
              {xp.role}
              <br />
              <span class="muted">
                {xp.company}, client {xp.client}
              </span>
            </p>
            <p>{xp.summary}</p>
            <ul>
              {xp.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
            <p class="xp-stack">
              <span class="visually-hidden">Environnement technique&#8239;: </span>
              <span translate="no">{xp.stack.join(', ')}</span>
            </p>
          </article>
        </li>
      ))
    }
  </ol>

  </Section>

  {
    site.showDocuments ? (
      <PageEnd secondary={{ href: site.resumePdf, label: 'Dossier de compétences (PDF)' }} />
    ) : (
      <PageEnd secondary={{ href: '/expertise/', label: 'Voir l’expertise' }} />
    )
  }
</BaseLayout>

<style>
  .timeline > .row { padding-block: var(--space-8); }
  .timeline > .row:first-child { padding-top: 0; }
  .timeline h3 { font-size: 1.35rem; letter-spacing: -0.015em; }
  .xp-meta { font-weight: 500; }
  .xp-stack {
    padding-top: var(--space-3);
    font-size: var(--t-small);
    color: var(--ardoise);
  }
</style>
