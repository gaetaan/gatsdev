---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import PageEnd from '../components/PageEnd.astro';
import { technical, training } from '../data/skills';

const leadership = [
  {
    title: 'Pilotage technique',
    text: 'Définition de l’architecture applicative et de la stratégie technique, refonte de monolithes vers des microservices, montées de version majeures (Angular, Quarkus, Java).',
  },
  {
    title: 'Encadrement',
    text: 'Équipes de 3 à 8 personnes : management opérationnel, revues de code, normes de merge request, montée en compétences et en autonomie.',
  },
  {
    title: 'Référent transverse',
    text: 'L’un des trois référents techniques d’un plateau de 20 à 30 développeurs : appui aux équipes, arbitrages, présentations techniques.',
  },
  {
    title: 'Agilité',
    text: 'Scrum Master sur trois équipes : cérémonies, découpage et chiffrage des user stories, démonstrations client, amélioration continue.',
  },
  {
    title: 'Qualité de service',
    text: 'Accessibilité RGAA, sécurisation des API (gateway, contrôle d’accès par propriétaire), performances sur forte volumétrie, supervision et gestion des mises en production.',
  },
];
---

<BaseLayout
  title="Expertise Java, Quarkus, Angular, DDD"
  description="Compétences de Gaëtan Barbaria : Java 25, Quarkus 3, Angular 22, architecture hexagonale et DDD, Kafka, Oracle, Kubernetes, encadrement d’équipes et Scrum Master."
>
  <PageHeader title="Expertise">
    Un profil full stack orienté architecture, avec l’expérience de l’encadrement et de la coordination d’équipes sur
    des applications nationales à forte volumétrie.
  </PageHeader>

  <Section id="pilotage" title="Pilotage et méthodes">
    <ul class="rows">
      {
        leadership.map((l) => (
          <li class="row">
            <h3>{l.title}</h3>
            <p class="row-body">{l.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="socle" title="Socle technique">
    <dl class="rows">
      {
        technical.map((g) => (
          <div class="row">
            <dt class="row-label">{g.label}</dt>
            <dd class="row-body" translate="no">{g.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="formation" title="Formations et langues">
    <dl class="rows">
      {
        training.map((t) => (
          <div class="row">
            <dt class="row-label">{t.year}</dt>
            <dd class="row-body">{t.label}</dd>
          </div>
        ))
      }
      <div class="row">
        <dt class="row-label">Langues</dt>
        <dd class="row-body">Français (langue maternelle), anglais professionnel</dd>
      </div>
    </dl>
  </Section>

  <PageEnd secondary={{ href: '/experiences/', label: 'Voir les missions' }} />
</BaseLayout>
