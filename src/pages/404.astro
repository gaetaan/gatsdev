---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <header class="page-header">
    <h1>Page introuvable</h1>
    <p class="lede">L’adresse est peut-être mal saisie, ou la page a été déplacée. Repartez de l’accueil ou écrivez-moi si un lien est cassé.</p>
  </header>
  <div class="actions">
    <a class="button" href="/">Retour à l’accueil</a>
  </div>
</BaseLayout>
