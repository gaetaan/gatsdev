---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Mission freelance')}`;
---

<BaseLayout
  title="Contact et disponibilité"
  description={`Contactez Gaëtan Barbaria, lead tech full stack Java / Angular freelance à Aix-Marseille, disponible en ${site.availability}.`}
>
  <PageHeader title="Parlons de votre projet">
    Décrivez-moi votre contexte en quelques lignes&#8239;: l’application, l’équipe, l’enjeu et le calendrier.
  </PageHeader>

  <Section id="coordonnees" title="Coordonnées">
    <dl class="rows">
      <div class="row">
        <dt class="row-label">Email</dt>
        <dd class="row-body">
          <div class="email">
            <a class="contact-main" href={mailto}>{site.email}</a>
            <button type="button" class="copy" data-copy={site.email} hidden>
              <span data-copy-label>Copier</span><span class="visually-hidden"> l’adresse email</span>
            </button>
          </div>
          <p class="visually-hidden" aria-live="polite" data-copy-status></p>
        </dd>
      </div>
      <div class="row">
        <dt class="row-label">LinkedIn</dt>
        <dd class="row-body">
          <a href={site.linkedin} rel="me noopener">Gaëtan Barbaria sur LinkedIn</a>
        </dd>
      </div>
      {
        site.showDocuments && (
          <div class="row">
            <dt class="row-label">Documents</dt>
            <dd class="row-body">
              <ul class="docs">
                <li>
                  <a href={site.resumePdf} download>Dossier de compétences</a>
                  <span class="muted">PDF, 7&nbsp;pages, 640&nbsp;Ko</span>
                </li>
                <li>
                  <a href={site.cvPdf} download>CV</a>
                  <span class="muted">PDF, 1&nbsp;page, 340&nbsp;Ko</span>
                </li>
              </ul>
            </dd>
          </div>
        )
      }
    </dl>
  </Section>

  <Section id="modalites" title="Modalités">
    <dl class="rows">
      <div class="row">
        <dt class="row-label">Disponibilité</dt>
        <dd class="row-body"><span class="availability">À partir de {site.availability}</span></dd>
      </div>
      <div class="row">
        <dt class="row-label">Lieu</dt>
        <dd class="row-body">Aix‑Marseille, en télétravail ou en mode hybride</dd>
      </div>
      <div class="row">
        <dt class="row-label">Statut</dt>
        <dd class="row-body">Freelance, entrepreneur individuel</dd>
      </div>
    </dl>
  </Section>
</BaseLayout>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-copy]');
    if (!btn || !navigator.clipboard) return;
    const label = btn.querySelector('[data-copy-label]');
    const status = document.querySelector('[data-copy-status]');
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        label.textContent = 'Copié';
        status.textContent = 'Adresse email copiée';
        setTimeout(() => { label.textContent = 'Copier'; status.textContent = ''; }, 2000);
      } catch (e) {}
    });
  })();
</script>

<style>
  .email { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-4); }
  .copy {
    min-height: 2.75rem;
    padding: 0.3rem 1rem;
    font: inherit;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--cobalt);
    background: transparent;
    border: 1px solid var(--filet);
    border-radius: 999px;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .copy:hover { background: var(--cobalt-voile); border-color: var(--cobalt); }
  .copy[hidden] { display: none; }
  .contact-main { font-size: 1.35rem; font-weight: 600; overflow-wrap: anywhere; }
  .docs { list-style: none; padding: 0; }
  .docs li { display: grid; }
  .docs li + li { margin-top: var(--space-3); }
  .docs a { font-weight: 600; }
  .docs .muted { font-size: var(--t-small); }
</style>
