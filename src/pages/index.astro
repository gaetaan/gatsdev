---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PageEnd from '../components/PageEnd.astro';
import { site } from '../data/site';
import { experiences } from '../data/experiences';

const recent = experiences.slice(0, 2);
const stack = ['Java 25', 'Quarkus 3', 'Angular 22', 'Kafka', 'Oracle', 'Kubernetes'];

const offers = [
  {
    title: 'Piloter une refonte',
    text: 'Passer d’un monolithe ou d’une application instable à des microservices DDD / hexagonaux, sans interrompre le service : cadrage, architecture cible, découpage, mises en production.',
  },
  {
    title: 'Concevoir et livrer, back et front',
    text: 'Java / Quarkus côté serveur, Angular côté interface, événementiel avec Kafka et Debezium. Avec ce qui va avec : performances Oracle, sécurité des API, accessibilité RGAA, supervision en production.',
  },
  {
    title: 'Faire grandir l’équipe',
    text: 'Encadrement d’équipes de 3 à 8 personnes, référent technique d’un plateau de 20 à 30 développeurs, Scrum Master : standards communs, revues de code, montée en autonomie.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.owner,
      jobTitle: 'Lead tech full stack Java / Angular',
      url: site.url,
      email: `mailto:${site.email}`,
      sameAs: [site.linkedin],
      address: { '@type': 'PostalAddress', addressLocality: 'Marseille', addressRegion: 'Provence-Alpes-Côte d’Azur', addressCountry: 'FR' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Aix-Marseille Université' },
      knowsAbout: ['Java', 'Quarkus', 'Angular', 'Domain-Driven Design', 'Architecture hexagonale', 'Microservices', 'Kafka', 'Scrum'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: site.brand,
      url: site.url,
      email: `mailto:${site.email}`,
      founder: { '@id': `${site.url}/#person` },
      areaServed: [
        { '@type': 'City', name: 'Marseille' },
        { '@type': 'City', name: 'Aix-en-Provence' },
        { '@type': 'Country', name: 'France' },
      ],
    },
  ],
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="availability">Disponible en {site.availability}</p>
      <h1 id="hero-title">{site.owner}</h1>
      <p class="hero-role">Lead tech full stack Java&nbsp;/&nbsp;Angular, freelance à&nbsp;Aix‑Marseille</p>
      <p class="hero-stack">
        <span class="visually-hidden">Technologies principales&#8239;: </span>
        <span translate="no">{stack.join(', ')}</span>
      </p>
      <p class="lede">
        J’accompagne les équipes qui doivent faire évoluer une application métier critique. Depuis {site.yearsOfExperience}&nbsp;ans,
        sur des applications utilisées dans toute la France, je conçois l’architecture, je code côté serveur comme côté
        interface, et je fais monter l’équipe en autonomie.
      </p>
      <div class="actions">
        <a class="button" href="/contact/">Me contacter</a>
        <a class="button button--ghost" href="/experiences/">Voir les missions</a>
      </div>
    </div>
  </section>

  <Section id="offre" title="Domaines d’intervention">
    <ul class="rows">
      {
        offers.map((o) => (
          <li class="row">
            <h3>{o.title}</h3>
            <p class="row-body">{o.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="missions" title="Missions récentes">
    <ul class="rows">
      {
        recent.map((xp) => (
          <li class="row">
            <p class="row-label">
              <time datetime={xp.start}>{xp.period}</time>
            </p>
            <div class="row-body">
              <h3>
                <a href={`/experiences/#${xp.id}`}>{xp.title}</a>
              </h3>
              <p class="muted">
                {xp.role}, projet <span translate="no">{xp.project}</span> pour {xp.client}
              </p>
              <p>{xp.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/experiences/">Toutes les missions depuis 2020</a></p>
  </Section>

  <PageEnd secondary={{ href: '/expertise/', label: 'Voir l’expertise' }} />
</BaseLayout>

<style>
  .hero { max-width: 44rem; padding-top: var(--space-12); }
  @media (max-width: 40rem) {
    .hero { padding-top: var(--space-4); }
    .availability { margin-bottom: var(--space-6); }
  }
  .availability { margin-bottom: var(--space-8); }
  .hero-role {
    margin-top: var(--space-4);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    font-weight: 500;
  }
  .hero-stack { margin-top: var(--space-2); color: var(--ardoise); font-size: var(--t-small); letter-spacing: 0.01em; }
  .hero .lede { margin-top: var(--space-6); }

  .row-body h3 a { color: var(--encre); text-decoration-color: var(--filet); }
  .row-body h3 a:hover { color: var(--cobalt-fonce); text-decoration-color: currentColor; }
  .more { margin-top: var(--space-6); font-weight: 500; }
</style>
