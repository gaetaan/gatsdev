{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gatsdev-preview",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": [
        "node_modules/astro/bin/astro.mjs",
        "preview",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "gatsdev-preview-alt",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4322",
        "--directory",
        "dist"
      ],
      "port": 4322
    }
  ]
}